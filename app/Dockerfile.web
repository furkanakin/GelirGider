# Multi-stage build for Evimiz PWA.
# Build context = repository root (Coolify "Base directory" = ".").
# Coolify "Dockerfile location" = "app/Dockerfile.web".
#
# Build args:
#   API_BASE_URL  — backend URL the PWA should hit at runtime
#                   (e.g. https://api.evimiz.tr/api). REQUIRED.

# ---------- Stage 1: Flutter SDK + build ----------
FROM debian:bookworm-slim AS builder

ARG API_BASE_URL
RUN test -n "$API_BASE_URL" || (echo "API_BASE_URL build arg is required" && exit 1)

ENV DEBIAN_FRONTEND=noninteractive \
    PUB_CACHE=/root/.pub-cache \
    PATH=/opt/flutter/bin:/opt/flutter/bin/cache/dart-sdk/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl unzip xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pin to a known stable Flutter version.
RUN git clone --depth 1 -b stable https://github.com/flutter/flutter.git /opt/flutter \
    && flutter --version \
    && flutter config --no-analytics \
    && flutter precache --web --no-android --no-ios --no-linux --no-macos --no-windows

WORKDIR /src
# Copy only what the Flutter app needs to keep this layer cacheable.
COPY app /src/app

WORKDIR /src/app
RUN flutter pub get
# `--pwa-strategy=none` disables Flutter's offline-first service worker. Every
# visit fetches fresh assets, so users never see a stale build after we ship
# changes — at the cost of needing network on first paint (we never relied on
# offline anyway). Combined with nginx's no-cache header on index.html this
# gives reliable instant-update behavior across browsers.
RUN flutter build web --release --pwa-strategy=none --dart-define=API_BASE_URL=${API_BASE_URL}

# ---------- Stage 2: nginx static server ----------
FROM nginx:alpine AS runtime

# Aggressive caching for hashed assets, no-cache for entry & service worker.
RUN printf '%s\n' \
    'server {' \
    '  listen 80;' \
    '  root /usr/share/nginx/html;' \
    '  index index.html;' \
    '  location / { try_files $uri $uri/ /index.html; }' \
    '  location = /index.html { add_header Cache-Control "no-cache"; }' \
    '  location = /flutter_service_worker.js { add_header Cache-Control "no-cache"; }' \
    '  location ~* \.(?:js|css|woff2?|ttf|otf|svg|png|jpg|webp|wasm)$ { expires 1y; add_header Cache-Control "public, immutable"; }' \
    '  gzip on; gzip_types text/css application/javascript application/json application/wasm image/svg+xml;' \
    '}' > /etc/nginx/conf.d/default.conf

COPY --from=builder /src/app/build/web/ /usr/share/nginx/html/

EXPOSE 80
